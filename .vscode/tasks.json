{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EdgeTX: Run widget tests",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-LuaTests.ps1",
        "-Workspace",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Sync MK3 simulator SD",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "mk3",
        "-SyncOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Sync GX15 simulator SD",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "gx15",
        "-SyncOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Simulate TX16S MK3",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "mk3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Simulate GX15",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "gx15"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Test + Simulate TX16S MK3",
      "dependsOrder": "sequence",
      "dependsOn": [
        "EdgeTX: Run widget tests",
        "EdgeTX: Simulate TX16S MK3"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Test + Simulate GX15",
      "dependsOrder": "sequence",
      "dependsOn": [
        "EdgeTX: Run widget tests",
        "EdgeTX: Simulate GX15"
      ],
      "problemMatcher": []
    }
  ]
}
