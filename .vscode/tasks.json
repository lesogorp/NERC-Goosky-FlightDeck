{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EdgeTX: Run widget tests",
      "type": "shell",
      "command": "lua",
      "args": ["tests/run_tests.lua"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$runner = Get-Command lua -ErrorAction SilentlyContinue; if (-not $runner) { $runner = Get-Command lua53 -ErrorAction SilentlyContinue }; if (-not $runner) { $runner = Get-Command texlua -ErrorAction SilentlyContinue }; if (-not $runner) { throw 'Install Lua 5.3, add it to PATH, then restart VS Code.' }; & $runner.Source tests/run_tests.lua; $code = $LASTEXITCODE; if ($null -eq $code) { $code = 0 }; if ($code -ne 0) { Write-Host ('NERC widget tests FAILED (exit ' + $code + ')') -ForegroundColor Red; exit $code }; Write-Host 'NERC widget tests PASSED' -ForegroundColor Green; exit 0"
        ]
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Sync MK3 simulator SD",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "mk3",
        "-SyncOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Sync GX15 simulator SD",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "gx15",
        "-SyncOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Simulate TX16S MK3",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "mk3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Simulate GX15",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\Run-EdgeTXSimulator.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-Target",
        "gx15"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Test + Simulate TX16S MK3",
      "dependsOrder": "sequence",
      "dependsOn": [
        "EdgeTX: Run widget tests",
        "EdgeTX: Simulate TX16S MK3"
      ],
      "problemMatcher": []
    },
    {
      "label": "EdgeTX: Test + Simulate GX15",
      "dependsOrder": "sequence",
      "dependsOn": [
        "EdgeTX: Run widget tests",
        "EdgeTX: Simulate GX15"
      ],
      "problemMatcher": []
    }
  ]
}
